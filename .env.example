# ==============================================================================
# AttendSync Environment Configuration Template
# Copy this file to '.env' and adjust the variables as needed.
# ==============================================================================

# Flask application entry point and environment
FLASK_APP=wsgi.py
FLASK_ENV=development
DEBUG=True

# Application secret key for session signing and CSRF protection
SECRET_KEY=attendsync_super_secret_dev_key_change_in_production_9a7d3

# SQLite database connection URL
# Uses an instance-relative SQLite database file by default
DATABASE_URL=sqlite:///instance/attendsync.db

# Server port configuration
PORT=5000
